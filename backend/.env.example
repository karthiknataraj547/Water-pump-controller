# JWT Secrets & Security
JWT_SECRET="super_secret_jwt_key_pump_iot_2026"
JWT_REFRESH_SECRET="super_secret_refresh_jwt_key_pump_iot_2026"
JWT_ACCESS_EXPIRES_IN="1d"
